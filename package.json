{
  "name": "@unabandoned/module-deps",
  "version": "6.2.4",
  "description": "walk the dependency graph to generate json output that can be fed into browser-pack",
  "main": "index.js",
  "bin": {
    "module-deps": "bin/cmd.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/module-deps.git"
  },
  "bugs": {
    "url": "https://github.com/unabandoned/module-deps/issues"
  },
  "homepage": "https://github.com/unabandoned/module-deps#readme",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "dependency",
    "graph",
    "browser",
    "require",
    "module",
    "exports",
    "json"
  ],
  "dependencies": {
    "JSONStream": "1.3.5",
    "browser-resolve": "2.0.0",
    "cached-path-relative": "1.1.0",
    "concat-stream": "2.0.0",
    "defined": "1.0.1",
    "detective": "5.2.1",
    "duplexer2": "0.1.4",
    "inherits": "2.0.4",
    "parents": "1.0.1",
    "readable-stream": "4.7.0",
    "resolve": "1.22.12",
    "stream-combiner2": "1.1.1",
    "subarg": "1.0.0",
    "through2": "5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "browser-pack": "6.1.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test test/*.js"
  },
  "author": {
    "name": "James Halliday",
    "email": "mail@substack.net",
    "url": "http://substack.net"
  },
  "license": "MIT"
